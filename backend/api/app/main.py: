from fastapi import FastAPI

app = FastAPI(
    title="CloudCart API",
    version="0.1.0"
)


@app.get("/")
def root():
    return {
        "service": "cloudcart-api",
        "status": "running"
    }


@app.get("/health")
def health():
    return {
        "status": "healthy"
    }


@app.get("/api/v1/products")
def get_products():
    return [
        {
            "id": 1,
            "name": "Mechanical Keyboard",
            "price": 4999
        },
